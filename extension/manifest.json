{
  "manifest_version": 3,
  "name": "ResumeAnalyzer Helper",
  "version": "1.0.0",
  "description": "Helper extension for the ResumeAnalyzer application.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:*/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ResumeAnalyzer"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*.linkedin.com/*", "https://*.indeed.com/*"],
      "js": ["content.js"]
    },
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "http://localhost:5173/*"
      ],
      "js": ["injector.js"],
      "run_at": "document_idle"
    }
  ]
}
